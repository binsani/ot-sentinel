POSTGRES_DB=ot_sentinel
POSTGRES_USER=ot_sentinel
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql+psycopg://ot_sentinel:change-me-before-deployment@db:5432/ot_sentinel
SENSOR_INGEST_API_KEY=replace-with-a-long-random-secret
SENSOR_ID=sensor-01
SITE_ID=default
FEED_DIRECTORY=./feeds
FEED_INTERVAL_SECONDS=3600
VIEWER_API_KEY=replace-with-a-different-long-random-secret
ADMIN_API_KEY=replace-with-another-long-random-secret
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_API_KEYS_ENABLED=true
# Configure these for corporate identity. Set either OIDC_JWKS_URL or OIDC_JWKS_FILE.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_JWKS_FILE=
